      "id": "b8b61987-4cb8-43b4-b952-25f99db095f5",
      "name": "Find Leads(SerpAPI)"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\n// SerpAPI returns results in 'local_results'\nconst businesses = response.local_results || [];\n\nif (businesses.length === 0) {\n  console.log('No businesses found');\n  return [];\n}\n\nconsole.log(`Found ${businesses.length} hospitals`);\n\n// Get the searched ZIP for reference\nconst searchedZip = $('Edit Fields').first().json.currentZip || '';\n\nreturn businesses.map(biz => {\n  // Get GPS coordinates\n  const lat = biz.gps_coordinates?.latitude || '';\n  const lon = biz.gps_coordinates?.longitude || '';\n  const departments = biz.types ? biz.types.join(', ') : '';\n  // Get service types/categories\n  const services = biz.types ? biz.types.join(', ') : '';\n  \n  // Format operating hours better\n  const hours = biz.hours || biz.open_state || '';\n  \n  return {\n    json: {\n      searchedZip: searchedZip,\n      hospitalName: biz.title || '',\n      address: biz.address || '',\n      latitude: lat,\n      longitude: lon,\n      phone: biz.phone || '',\n      rating: biz.rating || '',\n      hospitalType: biz.type || '',\n      departments: departments,\n      services: services,\n      hours: hours,\n      website: biz.website || '',\n      googleMapsUrl: biz.place_id \n        ? `https://www.google.com/maps/place/?q=place_id:${biz.place_id}` \n        : '',\n      placeId: biz.place_id || '',\n      scrapedDate: new Date().toISOString().split('T')[0]\n    }\n  };\n});"
      },
