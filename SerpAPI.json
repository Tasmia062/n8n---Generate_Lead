    },
    {
      "parameters": {
        "jsCode": "// Get input ZIP codes (from \"Get row(s) in sheet\")\nconst inputZips = $('Get row(s) in sheet').all();\n\nconsole.log('=== DEDUPLICATION CHECK ===');\nconsole.log(`Total input ZIPs: ${inputZips.length}`);\nconsole.log('Input ZIPs:', inputZips.map(i => i.json.zip));\n\n// Get already scraped ZIP codes (from \"Read Existing Results\")\nlet existingResults = [];\n\ntry {\n  // Try to get existing results\n  const readNode = $('Read Existing Results');\n  if (readNode && readNode.all) {\n    existingResults = readNode.all();\n  }\n  console.log(`Existing results found: ${existingResults.length}`);\n} catch (error) {\n  console.log('Error reading existing results (sheet might be empty):', error.message);\n  existingResults = [];\n}\n\n// Handle empty sheet case - return ALL ZIPs as new\nif (!existingResults || existingResults.length === 0) {\n  console.log('✅ Sheet is empty - processing ALL input ZIPs');\n  console.log('Returning all ZIPs:', inputZips.map(i => i.json.zip));\n  return inputZips;\n}\n\n// Extract unique scraped ZIPs\nconst scrapedZips = new Set();\n\nexistingResults.forEach(item => {\n  if (item && item.json && item.json.searchedZip) {\n    scrapedZips.add(item.json.searchedZip);\n  }\n});\n\nconsole.log(`Already scraped ZIPs: ${scrapedZips.size}`);\nconsole.log('Scraped ZIPs:', Array.from(scrapedZips).slice(0, 10));\n\n// Filter to only NEW ZIPs that haven't been scraped\nconst newZips = inputZips.filter(item => {\n  const zip = item.json.zip;\n  const isNew = !scrapedZips.has(zip);\n  \n  if (isNew) {\n    console.log(`  ✓ ${zip} - NEW (will process)`);\n  } else {\n    console.log(`  ✗ ${zip} - Already scraped (skip)`);\n  }\n  \n  return isNew;\n});\n\nconsole.log(`\\n📊 Summary: ${newZips.length} new ZIPs to process (out of ${inputZips.length} total)`);\n\n// If no new ZIPs, return empty array\nif (newZips.length === 0) {\n  console.log('⚠️ No new ZIPs to process - all have been scraped already!');\n  return [];\n}\n\n// Return only new ZIPs\nconsole.log('Returning new ZIPs:', newZips.map(i => i.json.zip));\nreturn newZips;"
      },
