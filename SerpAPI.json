        "jsCode": "console.log('✅ All ZIP codes have already been scraped. No new data to process.');\n\nreturn [{\n  json: {\n    status: 'skipped',\n    message: 'All ZIP codes have already been scraped',\n    timestamp: new Date().toISOString()\n  }\n}];"
